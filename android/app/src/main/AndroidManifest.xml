<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Android discards a notification aimed at a channel that does not
             exist, so FCM messages that name no channel land here instead. The
             app creates this channel on launch; naming it as the default keeps
             delivery working on a build that has not yet run. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="faidafarm_default" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- The assistant photographs a crop and attaches saved photos through a
         plain file input, which the WebView hands to the system photo picker
         and the camera app. Both return a content URI this app may read on the
         spot, so no storage or camera permission is needed - and asking for
         READ_MEDIA_IMAGES would put the listing under Play's photo and video
         policy for a capability the code never requests at runtime.

         CAMERA in particular is worse than unnecessary: declaring it makes
         ACTION_IMAGE_CAPTURE demand it be granted, so declaring it can break
         the very button it appears to enable. -->
</manifest>
