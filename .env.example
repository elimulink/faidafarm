# Frontend configuration. Copy to .env.local and fill in.
# None of these are secrets - a Firebase web config ships inside every client -
# but they differ per project, so they are not committed.

# From Firebase console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=faidafarm-baa26.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=faidafarm-baa26
VITE_FIREBASE_STORAGE_BUCKET=faidafarm-baa26.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=885156990402
VITE_FIREBASE_APP_ID=

# Where the FastAPI backend is reachable. Leave blank to keep the app on
# local sample data.
VITE_API_BASE_URL=

# Set to any value once /api/v1/assistant/chat is live, to move the assistant
# off its demonstration replies.
VITE_ASSISTANT_API=
